{
  "name": "turbo-startup",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check:tailwind": "pnpm --filter @repo/web check:tailwind",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:web-smoke": "pnpm --filter @repo/web test -- --test-name-pattern \"web smoke\"",
    "test:web-e2e": "pnpm --filter @repo/web test:e2e:xss",
    "format": "turbo run format",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:studio": "pnpm --filter @repo/database db:studio"
  },
  "devDependencies": {
    "tailwindcss": "^4.2.1",
    "turbo": "2.8.13",
    "typescript": "5.9.3"
  }
}
