# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres?schema=public&sslmode=require"
DIRECT_URL="postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres?schema=public&sslmode=require"

# API/Web topology
API_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:3000"
ALLOWED_WEB_ORIGIN="http://localhost:3000"
TRUST_PROXY="false"

# Auth secrets
JWT_ACCESS_SECRET="replace-with-strong-random-secret"
REFRESH_TOKEN_PEPPER="replace-with-strong-random-secret"
CSRF_TOKEN_SECRET="replace-with-strong-random-secret-at-least-32-chars"
MOBILE_AUTH_SHARED_SECRET="replace-with-strong-random-secret"
COOKIE_SECRET="replace-with-strong-random-secret"

# Auth TTLs
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_SECONDS="2592000"
REFRESH_COOKIE_SAME_SITE="lax"
CSRF_COOKIE_NAME="csrf_token"
