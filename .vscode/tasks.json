{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup project",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Install dependencies",
        "Prisma: generate client",
        "Prisma: migrate deploy"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "pnpm install",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Prisma: generate client",
      "type": "shell",
      "command": "pnpm db:generate",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Prisma: migrate deploy",
      "type": "shell",
      "command": "pnpm --filter @repo/database exec prisma migrate deploy",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Kill dev ports",
      "type": "shell",
      "command": "sh -c 'PIDS=$( (lsof -tiTCP:3000 -sTCP:LISTEN || true; lsof -tiTCP:4000 -sTCP:LISTEN || true) | sort -u ); if [ -n \"$PIDS\" ]; then kill $PIDS; fi'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Kill dev ports"
      ],
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
